---
import SeboHomeIsland from "@/components/islands/SeboHomeIsland";
import Agenda from "@/components/sections/Agenda.astro";
import Contato from "@/components/sections/Contato.astro";
import Espaco from "@/components/sections/Espaco.astro";
import Footer from "@/components/sections/Footer.astro";
import Hero from "@/components/sections/Hero.astro";
import LojaHome from "@/components/sections/LojaHome.astro";
import Pilares from "@/components/sections/Pilares.astro";
import Sobre from "@/components/sections/Sobre.astro";
import VisitacaoCTA from "@/components/sections/VisitacaoCTA.astro";
import { getEventosFuturos } from "@/intake/evento";
import BaseLayout from "@/layouts/BaseLayout.astro";

const eventos = (await getEventosFuturos()).slice(0, 3);
---

<BaseLayout
  title="Estúdio Entre — Hub Cultural no Méier, RJ"
  description="Hub cultural e criativo independente no Méier, Rio de Janeiro. Agenda de shows, oficinas, saraus e exposições. Sebo colaborativo, loja autoral e produção de conteúdo."
>
  <Hero />
  <Sobre />
  <Pilares />
  <Espaco />
  <Agenda eventos={eventos} />
  <SeboHomeIsland client:visible />
  <LojaHome />
  <VisitacaoCTA />
  <Contato />
  <Footer />
</BaseLayout>
