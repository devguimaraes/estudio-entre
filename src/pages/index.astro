---
import SeboHomeIsland from "@/components/islands/SeboHomeIsland";
import Agenda from "@/components/sections/Agenda.astro";
import Contato from "@/components/sections/Contato.astro";
import Espaco from "@/components/sections/Espaco.astro";
import Footer from "@/components/sections/Footer.astro";
import Hero from "@/components/sections/Hero.astro";
import LojaHome from "@/components/sections/LojaHome.astro";
import Pilares from "@/components/sections/Pilares.astro";
import Sobre from "@/components/sections/Sobre.astro";
import VisitacaoCTA from "@/components/sections/VisitacaoCTA.astro";
import { getEventosFuturos } from "@/intake/evento";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { PAGE_SEO } from "@/utils/seo";

const eventos = (await getEventosFuturos()).slice(0, 3);
---

<BaseLayout
  title={PAGE_SEO.home.title}
  description={PAGE_SEO.home.description}
>
  <script is:inline>
    function redirectLegacyGaleriaHash() {
      if (window.location.hash !== "#galeria") return;
      history.replaceState(null, "", `${window.location.pathname}#espaco`);
      document.getElementById("espaco")?.scrollIntoView({ block: "start" });
    }

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", redirectLegacyGaleriaHash);
    } else {
      redirectLegacyGaleriaHash();
    }

    window.addEventListener("hashchange", redirectLegacyGaleriaHash);
  </script>
  <Hero />
  <Sobre />
  <Pilares />
  <Espaco />
  <Agenda eventos={eventos} />
  <SeboHomeIsland client:visible />
  <LojaHome />
  <VisitacaoCTA />
  <Contato />
  <Footer />
</BaseLayout>
