---
import AgendaIsland from "@/components/islands/agenda/AgendaIsland";
import Decorative from "@/components/ui/Decorative.astro";
import HalftoneTexture from "@/components/ui/HalftoneTexture.astro";
import NoiseTexture from "@/components/ui/NoiseTexture.astro";
import { getEventosFuturos } from "@/intake/evento";
import BaseLayout from "@/layouts/BaseLayout.astro";

const eventos = await getEventosFuturos();
---

<BaseLayout
  title="Agenda — Estúdio Entre"
  description="Confira os próximos encontros, oficinas, shows, saraus e vivências do Estúdio Entre no Méier, Rio de Janeiro."
  navTheme="dark"
>
  <main class="relative min-h-screen overflow-hidden bg-cream px-4 pb-24 pt-32 text-forest md:px-16 md:pt-40">
    <HalftoneTexture density={12} dotSize={1} color="29,67,44" opacity={0.03} class="z-0" />
    <NoiseTexture opacity={0.08} />

    <div class="decorative-asset absolute right-[8%] top-36 opacity-25">
      <Decorative variant="star" color="#EC6838" size={48} />
    </div>
    <div class="decorative-asset absolute bottom-24 left-[6%] opacity-20">
      <Decorative variant="dots" color="#3D1020" size={54} />
    </div>

    <div class="relative z-10 mx-auto max-w-[1300px]">
      <header class="mb-12 max-w-4xl md:mb-20">
        <p class="font-display text-[11px] font-black uppercase tracking-[0.4em] text-forest/40">
          Encontros & Vivências
        </p>
        <h1 class="mt-6 font-display text-[clamp(3.5rem,10vw,8.5rem)] font-black uppercase leading-[0.8] text-forest">
          Agenda<br />
          <span class="text-orange">cultural</span>
        </h1>
        <p class="mt-8 max-w-xl text-base leading-relaxed text-forest/60 md:text-lg">
          Explore os próximos encontros do Estúdio Entre por mês, categoria ou palavra-chave.
        </p>
      </header>

      <AgendaIsland client:load mode="full" eventos={eventos} />
    </div>
  </main>
</BaseLayout>

<script>
  import { gsap } from "gsap";

  // Floating animation for decorative elements
  gsap.to(".decorative-asset", {
    y: "random(-15, 15)",
    x: "random(-10, 10)",
    rotation: "random(-5, 5)",
    duration: "random(3, 5)",
    repeat: -1,
    yoyo: true,
    ease: "sine.inOut",
    stagger: {
      amount: 2,
      from: "random"
    }
  });
</script>
