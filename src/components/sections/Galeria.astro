---
import TornPaperFrame from "@/components/ui/TornPaperFrame.astro";
import HalftoneTexture from "@/components/ui/HalftoneTexture.astro";
import Decorative from "@/components/ui/Decorative.astro";
import { Image } from "astro:assets";
import texturePaper from "@/assets/textures/old-paper-vintage-texture-surface-background-recycle-pale-brown-paper-crumpled-texture.webp";

const imagens = [
  { src: "/images/espaco/v2-meier-02.webp", alt: "Acesso e Acolhimento" },
  { src: "/images/espaco/v2-meier-03.webp", alt: "Nossa Estrutura" },
  { src: "/images/espaco/v2-meier-04.webp", alt: "Arte no Méier" },
  { src: "/images/espaco/estudio-entre-salao.webp", alt: "O Hub" },
];

// Duplicar para o marquee infinito
const marqueeImages = [...imagens, ...imagens, ...imagens];

// Função para rotação aleatória leve e orgânica
const getRotation = (i: number) => {
  const angles = ["-1.5deg", "1.2deg", "-0.8deg", "2deg", "0.5deg", "-1.2deg"];
  return angles[i % angles.length];
};
---

<section
  class="galeria relative pt-12 md:pt-20 pb-32 md:pb-52 overflow-hidden"
  id="galeria"
  style="background-color: #b9e4eb;"
>
  <!-- Smooth Fade transition from Hero -->
  <div class="absolute top-0 left-0 w-full h-24 z-20 pointer-events-none bg-gradient-to-b from-orange to-transparent opacity-20"></div>

  <!-- Background Assets -->
  <div class="absolute inset-0 z-0 opacity-[0.04] pointer-events-none mix-blend-multiply">
    <Image src={texturePaper} alt="" class="w-full h-full object-cover" />
  </div>

  <HalftoneTexture
    density={20}
    dotSize={1.2}
    color="61,16,32"
    opacity={0.06}
    class="z-[1]"
  />

  <!-- Floating Decor -->
  <div class="absolute top-[10%] right-[8%] opacity-20 z-10 hidden md:block">
    <Decorative variant="star" color="#3D1020" size={100} />
  </div>
  <div class="absolute bottom-[10%] left-[5%] opacity-15 z-10">
    <Decorative variant="dots" color="#3D1020" size={60} />
  </div>

  <div class="max-w-[1400px] mx-auto px-6 md:px-16 mb-16 relative z-10">
    <div class="overflow-hidden">
      <p class="galeria__eyebrow font-display font-bold text-[10px] md:text-[12px] uppercase tracking-[0.5em] text-bordo/40 opacity-0">
        O Lugar
      </p>
    </div>
    <h2 class="galeria__title font-display font-black text-[clamp(3rem,10vw,8rem)] text-bordo leading-[0.85] uppercase mt-8 opacity-0">
      Nosso <br />
      <span class="italic text-orange md:ml-32">Espaço</span>
    </h2>
  </div>

  <!-- Marquee Container -->
  <div class="galeria__marquee-wrapper relative flex overflow-visible py-20">
    <div class="galeria__marquee flex gap-16 md:gap-24 animate-marquee hover:pause whitespace-nowrap px-12">
      {marqueeImages.map((img, i) => (
        <div class="galeria__item w-[300px] md:w-[480px] flex-shrink-0">
          <div class="relative group h-[400px] md:h-[640px]">
            <TornPaperFrame 
              variant={(((i % 4) + 1) as 1 | 2 | 3 | 4)} 
              rotation={getRotation(i)}
              class="w-full h-full shadow-2xl transition-transform duration-500 group-hover:scale-[1.02] group-hover:-rotate-0"
            >
               <img
                src={img.src}
                alt={img.alt}
                class="w-full h-full object-cover transition-all duration-500 scale-[1.05] group-hover:scale-[1.1]"
                loading="lazy"
              />
            </TornPaperFrame>
            <div class="absolute inset-x-0 -bottom-12 text-center opacity-0 group-hover:opacity-100 transition-all duration-500 z-20 translate-y-4 group-hover:translate-y-0">
               <span class="font-display italic text-[11px] uppercase tracking-widest text-bordo bg-cream/95 px-6 py-3 rounded-full shadow-xl border border-bordo/5">
                { (i % imagens.length) + 1 }. { img.alt }
               </span>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>

  <script>
    import { animateGaleria } from "@/animations/galeria";
    animateGaleria();
  </script>
</section>

<style>
  .animate-marquee {
    animation: marquee 20s linear infinite;
  }

  .hover\:pause:hover {
    animation-play-state: paused;
  }

  @keyframes marquee {
    0% { transform: translateX(0); }
    100% { transform: translateX(-33.33%); }
  }

  @media (prefers-reduced-motion: reduce) {
    .animate-marquee {
      animation: none;
      overflow-x: auto;
    }
  }

  /* Gradiente de fade lateral mais suave */
  .galeria__marquee-wrapper {
    mask-image: linear-gradient(to right, transparent, black 15%, black 85%, transparent);
  }
</style>
