---
const pilares = [
  {
    id: "biblioterapia",
    title: "Biblioterapia",
    subtitle: "Leitura como cuidado",
    description:
      "Rodas de leitura que usam a literatura como ferramenta de autoconhecimento, escuta e transformação social.",
    color: "#9E4B2D", // terracota
    textColor: "#F0EDE8",
    icon: "/icons/olho.svg",
    size: "medium",
  },
  {
    id: "oficinas",
    title: "Oficinas",
    subtitle: "Criação coletiva",
    description:
      "Espaços de troca e aprendizado prático que unem arte, tecnologia e subjetividade.",
    color: "#BDB2DD", // lilás médio
    textColor: "#1A1612",
    icon: "/icons/spark.svg",
    size: "large",
  },
  {
    id: "palestras",
    title: "Palestras",
    subtitle: "Diálogos profundos",
    description: "Encontros com pensadores, artistas e educadores para expandir horizontes.",
    color: "#B9E4EB", // ciano
    textColor: "#1A1612",
    icon: "/icons/microfone.svg",
    size: "small",
  },
  {
    id: "estudio",
    title: "Estúdio",
    subtitle: "Produção e áudio",
    description:
      "Estrutura profissional para gravação de podcasts, videocasts e experimentações sonoras.",
    color: "#DEC72C", // mostarda
    textColor: "#1A1612",
    icon: "/icons/play.svg",
    size: "wide",
  },
  {
    id: "encontros",
    title: "Encontros",
    subtitle: "Conexão real",
    description:
      "Saraus, rodas de conversa e celebrações que fortalecem os laços entre pessoas e gerações.",
    color: "#EC6838", // laranja
    textColor: "#F0EDE8",
    icon: "/icons/pin.svg",
    size: "full",
  },
];

const sizeClasses = {
  small: "col-span-1 row-span-1 min-h-[280px]",
  medium: "col-span-1 row-span-1 md:col-span-1 md:row-span-2 min-h-[320px]",
  large: "col-span-1 row-span-1 md:col-span-2 md:row-span-2 min-h-[400px]",
  wide: "col-span-1 row-span-1 md:col-span-2 min-h-[300px]",
  full: "col-span-1 row-span-1 md:col-span-3 min-h-[300px]",
};
---

<section
  class="pilares relative py-24 md:py-40 px-6 md:px-16 overflow-hidden"
  style="background-color: #1A1612;"
  id="pilares"
>
  <!-- Background Decor -->
  <div class="absolute inset-0 pointer-events-none opacity-[0.03] z-0" aria-hidden="true">
    <div class="absolute top-20 left-10 font-display font-black text-[30vw] text-cream leading-none">FAZEMOS</div>
  </div>

  <div class="max-w-[1300px] mx-auto relative z-10">
    <div class="pilares__header mb-16 md:mb-24 flex flex-col md:flex-row md:items-end justify-between gap-8">
      <div class="overflow-hidden">
        <p class="pilares__eyebrow font-display font-bold text-[10px] uppercase tracking-[0.4em] text-cream/40 opacity-0">
          O que fazemos
        </p>
        <h2 class="pilares__title font-display font-black text-[clamp(2.5rem,6vw,4.5rem)] text-cream leading-none uppercase mt-6 opacity-0">
          Eixos de<br />Atuação
        </h2>
      </div>
      <p class="pilares__lead max-w-[320px] text-cream/60 text-sm leading-relaxed mb-2 opacity-0">
        Nossas frentes se entrelaçam para criar um ambiente de troca contínua e experimentação cultural.
      </p>
    </div>

    <!-- Bento Grid Container -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-4 md:gap-6 auto-rows-auto">

      {pilares.map((pilar, i) => (
        <div
          class={`pilar__cell relative overflow-hidden rounded-[2rem] p-8 md:p-12 transition-all duration-500 cursor-default group opacity-0 ${sizeClasses[pilar.size]}`}
          style={`background-color: ${pilar.color}; color: ${pilar.textColor};`}
          data-index={i}
        >
          <!-- Texture -->
          <div
            class="absolute inset-0 pointer-events-none opacity-[0.1]"
            style={`background-image: radial-gradient(${pilar.textColor} 1.5px, transparent 1.5px); background-size: 20px 20px;`}
          />

          <div class="relative z-10 h-full flex flex-col">
            <!-- Icon with organic shape background -->
            <div
              class="pilar__icon-wrap w-20 h-20 rounded-full flex items-center justify-center mb-10 transition-all duration-700 group-hover:scale-110 group-hover:rotate-[15deg] relative"
              style={`background-color: ${pilar.textColor}20`}
            >
               <!-- Subtle pulse background -->
               <div class="absolute inset-0 rounded-full animate-ping opacity-0 group-hover:opacity-20 duration-1000" style={`background-color: ${pilar.textColor}`}></div>
              <img
                src={pilar.icon}
                alt=""
                class="w-10 h-10 relative z-10"
                style={pilar.textColor === "#F0EDE8" ? "filter: brightness(0) invert(1)" : ""}
              />
            </div>

            <div class="mt-auto">
              <span class="font-display font-bold text-[10px] uppercase tracking-[0.4em] opacity-40 mb-4 block">
                0{i + 1}
              </span>
              <h3 class="pilar__title text-2xl md:text-3xl lg:text-4xl font-display font-black italic uppercase leading-[0.9] mb-4">
                {pilar.title}
              </h3>
              <p class="pilar__subtitle font-display italic text-lg opacity-60 mb-6">
                {pilar.subtitle}
              </p>
              <div class="h-[1px] w-12 bg-current opacity-30 mb-6 transition-all duration-500 group-hover:w-full"></div>
              <p class="pilar__desc text-sm md:text-base leading-relaxed opacity-70 max-w-[340px]">
                {pilar.description}
              </p>
            </div>
          </div>

          <!-- Hover Decor -->
          <div class="absolute bottom-[-20px] right-[-20px] opacity-0 group-hover:opacity-10 transition-opacity duration-500 pointer-events-none">
             <img src={pilar.icon} class="w-40 h-40" style={pilar.textColor === "#F0EDE8" ? "filter: brightness(0) invert(1)" : ""} alt="" />
          </div>
        </div>
      ))}

    </div>
  </div>

  <script>
    import { animatePilares } from "@/animations/pilares";
    animatePilares();
  </script>
</section>

<style>
  .pilar__cell {
    will-change: transform, opacity;
  }

  .pilar__cell:hover {
    box-shadow: 0 30px 60px -12px rgba(0, 0, 0, 0.4);
    z-index: 20;
  }
</style>