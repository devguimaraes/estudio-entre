---
// Servicos.astro — Layout editorial com SVGs da marca
// Expansão para 6 tópicos detalhados.
const servicos = [
  { icon: "/icons/olho.svg", title: "Oficinas Criativas", desc: "Espaços de troca e aprendizado prático que unem arte, tecnologia e subjetividade." },
  { icon: "/icons/microfone.svg", title: "Palestras & Rodas", desc: "Diálogos profundos sobre cultura contemporânea, bem-estar e o fazer criativo." },
  { icon: "/icons/calendario.svg", title: "Mentoria", desc: "Acompanhamento personalizado para projetos culturais em fase de desenvolvimento." },
  { icon: "/icons/play.svg", title: "Laboratório Audiovisual", desc: "Imersão técnica em captação, edição e narrativa para novos criadores." },
  { icon: "/icons/pin.svg", title: "Residência Artística", desc: "Tempo e espaço dedicado para artistas desenvolverem suas poéticas no território." },
  { icon: "/icons/spark.svg", title: "Circuito de Ideias", desc: "Encontros trimestrais fomentando a economia criativa e parcerias locais." }
];
---

<section class="servicos section-padding bg-cream text-near-black" id="servicos">
  <div class="servicos__inner max-w-7xl mx-auto px-6">
    <header class="mb-20">
      <span class="text-[10px] uppercase tracking-[0.4em] text-near-black/50 block mb-4">Núcleo de Criação</span>
      <h2 class="text-6xl md:text-8xl font-display italic font-black uppercase leading-none">
        Oficinas &<br/> Palestras
      </h2>
    </header>

    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-12">
      {servicos.map((s) => (
        <article class="servicos__card group cursor-none" data-cursor="VER">
          <div class="mb-8 p-6 bg-near-black/5 rounded-full inline-block group-hover:bg-orange transition-colors duration-500">
            <img src={s.icon} class="w-8 h-8 opacity-70 group-hover:invert group-hover:opacity-100 transition-all duration-500" alt="" />
          </div>
          <h3 class="text-2xl font-display italic font-bold mb-4">{s.title}</h3>
          <p class="text-sm leading-relaxed opacity-80">
            {s.desc}
          </p>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .section-padding { padding: 8rem 0; }
  
  .servicos__card {
    transition: transform 0.6s var(--ease-expo);
  }
  
  .servicos__card:hover {
    transform: translateY(-10px);
  }
</style>

<script>
  import gsap from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";
  
  gsap.registerPlugin(ScrollTrigger);
  
  gsap.fromTo(".servicos__card", 
    { opacity: 0, y: 50 },
    { 
      opacity: 1, 
      y: 0, 
      duration: 1, 
      stagger: 0.15, 
      ease: "power4.out",
      scrollTrigger: {
        trigger: ".servicos",
        start: "top 60%"
      }
    }
  );
</script>
