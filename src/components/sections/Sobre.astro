---
import BlobMask from "@/components/ui/BlobMask.astro";
import Decorative from "@/components/ui/Decorative.astro";
import HalftoneTexture from "@/components/ui/HalftoneTexture.astro";
---

<section
  class="sobre relative py-32 md:py-40 px-6 md:px-16 overflow-hidden"
  style="background-color: #f0ede8; color: #1a1612;"
  id="sobre"
>
  <!-- Halftone texture -->
  <HalftoneTexture
    density={16}
    dotSize={1.2}
    color="61,16,32"
    opacity={0.05}
    class="z-0"
  />

  <!-- Decorative elements -->
  <div class="absolute top-[10%] right-[8%] opacity-25 z-10">
    <Decorative variant="star" color="#9e4b2d" size={45} />
  </div>
  <div class="absolute bottom-[15%] left-[4%] opacity-15 z-10">
    <Decorative variant="dots" color="#3d1020" size={55} />
  </div>

  <!-- Watermark "e" -->
  <div
    class="sobre__watermark absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 font-display text-[50vw] font-black opacity-[0.02] pointer-events-none select-none z-0"
    style="color: #3d1020;"
  >
    e
  </div>

  <div class="max-w-6xl mx-auto relative z-10">
    <!-- Eyebrow -->
    <p class="sobre__eyebrow text-[10px] uppercase tracking-[0.4em] mb-10 opacity-0" style="color: #3d1020;">
      Nossa Essência
    </p>

    <!-- Title + Photo row -->
    <div class="flex flex-col lg:flex-row lg:items-start gap-12 lg:gap-20 mb-16">
      <div class="lg:w-[55%]">
        <h2
          class="sobre__title text-4xl sm:text-5xl md:text-6xl lg:text-7xl font-display font-black italic uppercase leading-[0.9] opacity-0"
          style="color: #3d1020;"
        >
          Uma mãe,<br /> uma filha<br /> e um sonho.
        </h2>
      </div>

      <div class="lg:w-[45%] flex justify-center lg:justify-end lg:pt-8">
        <div class="sobre__image-main w-[240px] md:w-[280px] opacity-0">
          <BlobMask variant={3} class="aspect-[4/5]">
            <img
              src="/images/brand/apresentacao-estudio-entre.jpg"
              alt="Thayná e Valdete — fundadoras do Estúdio Entre"
              class="w-full h-full object-cover"
            />
          </BlobMask>
        </div>
      </div>
    </div>

    <!-- Body text -->
    <div class="max-w-2xl mb-20">
      <p class="sobre__lead text-xl md:text-2xl leading-relaxed font-medium mb-8 opacity-0">
        O Estúdio Entre é um <span class="italic" style="color: #ec6838;">hub cultural multidisciplinar</span>,
        cuja missão é promover encontros significativos entre cultura, conhecimento e bem-estar.
      </p>

      <div class="space-y-6 text-base md:text-lg opacity-80 leading-relaxed">
        <p class="sobre__text opacity-0">
          Um espaço plural e acolhedor, onde arte, palavra e cuidado se entrelaçam. Por meio de
          experiências que unem literatura, comunicação e práticas integrativas, estimulamos a
          escuta, a criação e o acesso à expressão cultural.
        </p>
        <p class="sobre__text opacity-0">
          O hub reúne rodas de biblioterapia, oficinas, palestras e encontros culturais, além de
          disponibilizar um estúdio profissional para gravação de podcasts e videocasts.
        </p>
      </div>
    </div>

    <!-- Secondary image + signature -->
    <div class="flex flex-col md:flex-row md:items-end gap-12 md:gap-20">
      <div class="sobre__image-secondary w-[180px] md:w-[200px] opacity-0">
        <BlobMask variant={2} class="aspect-square">
          <img
            src="/images/brand/sobre-estudio-entre-4.jpg"
            alt="Afinal, o que é o Estúdio Entre?"
            class="w-full h-full object-cover"
          />
        </BlobMask>
      </div>

      <p
        class="sobre__signature text-xl md:text-2xl lg:text-3xl font-display italic md:flex-1 opacity-0"
        style="color: #3d1020;"
      >
        Entre palavras, entre pessoas — é só entrar.
      </p>
    </div>
  </div>

  <script>
    import { animateSobre } from "@/animations/sobre";
    animateSobre();
  </script>
</section>
