---
import BlobMask from "@/components/ui/BlobMask.astro";
import HalftoneTexture from "@/components/ui/HalftoneTexture.astro";
import sobreSubImg from "@/assets/images/Stories_Destaques 2_Estúdio Entre.webp";
---

<section
  class="sobre relative py-24 md:py-40 px-6 md:px-16 overflow-hidden"
  style="background-color: #f0ede8; color: #1a1612;"
  id="sobre"
>
  <!-- Watermark: Letra "e" cursiva gigante -->
  <div 
    class="sobre__watermark absolute -bottom-20 -right-20 z-0 pointer-events-none opacity-[0.03] select-none"
    aria-hidden="true"
  >
    <span class="font-display font-black text-[70vw] leading-none text-bordo italic">e</span>
  </div>

  <!-- Layer: Halftone texture bordô sutil -->
  <HalftoneTexture
    density={16}
    dotSize={1.2}
    color="61,16,32"
    opacity={0.06}
    class="z-[1]"
  />

  <div class="max-w-[1200px] mx-auto relative z-10">
    
    <!-- Top Row: Editorial Asymmetric Layout -->
    <div class="flex flex-col lg:flex-row gap-12 lg:gap-24 mb-24 md:mb-32">
      
      <!-- Text Column -->
      <div class="w-full lg:w-3/5 order-2 lg:order-1">
        <div class="sobre__eyebrow-wrap overflow-hidden mb-8">
          <p class="sobre__eyebrow font-display font-bold text-[10px] uppercase tracking-[0.4em] text-bordo opacity-0">
            Nossa Essência
          </p>
        </div>

        <h2 class="sobre__title mb-12 flex flex-col">
          <span class="sobre__title-line overflow-hidden">
            <span class="sobre__title-word block font-display font-black text-[clamp(2.5rem,7vw,5rem)] leading-[0.9] text-bordo uppercase opacity-0">
              Uma mãe,
            </span>
          </span>
          <span class="sobre__title-line overflow-hidden">
            <span class="sobre__title-word block font-display font-black text-[clamp(2.5rem,7vw,5rem)] leading-[0.9] text-bordo uppercase opacity-0">
              uma filha
            </span>
          </span>
          <span class="sobre__title-line overflow-hidden">
            <span class="sobre__title-word block font-display font-black text-[clamp(2.5rem,7vw,5rem)] leading-[0.9] text-bordo uppercase opacity-0">
              e um sonho.
            </span>
          </span>
        </h2>

        <div class="sobre__body-wrap max-w-[580px]">
          <p class="sobre__text text-lg md:text-xl leading-relaxed mb-8 opacity-0">
            O Estúdio Entre é um <span class="text-orange font-bold">hub cultural independente</span> localizado no Méier, cuja missão é promover encontros significativos entre cultura, conhecimento e bem-estar.
          </p>
          <p class="sobre__text text-base md:text-lg leading-relaxed text-near-black/70 mb-8 opacity-0">
            Um espaço plural e acolhedor, onde arte, palavra e cuidado se entrelaçam. Por meio de experiências que unem literatura, comunicação e práticas integrativas, estimulamos a escuta, a criação e o acesso à expressão cultural.
          </p>
          <p class="sobre__text text-base md:text-lg leading-relaxed text-near-black/70 opacity-0">
            O hub reúne rodas de <span class="italic font-medium">biblioterapia</span>, oficinas, palestras e encontros culturais, além de disponibilizar um estúdio profissional para gravação de podcasts e audições.
          </p>
        </div>
      </div>

      <!-- Main Image Column -->
      <div class="w-full lg:w-2/5 order-1 lg:order-2 flex justify-center lg:justify-end items-start pt-12">
        <div class="sobre__image-main relative w-full max-w-[380px]">
          <BlobMask
            variant={2}
            class="sobre__blob-1 opacity-0"
          >
            <img 
              src="/images/brand/apresentacao-estudio-entre.jpg" 
              alt="Thayná e Valdete — Fundadoras do Estúdio Entre"
              class="w-full h-full object-cover"
            />
          </BlobMask>
          
          <!-- Secondary Overlapping Image -->
          <div class="sobre__image-sub absolute -bottom-24 -left-16 w-[150px] md:w-[180px] z-10">
            <BlobMask
              variant={2}
              class="sobre__blob-2 opacity-0"
              style="transform: scaleX(-1);"
            >
              <img 
                src={sobreSubImg.src} 
                alt="Detalhe do espaço Estúdio Entre"
                class="w-full h-full object-cover object-center"
                style="transform: scaleX(-1);"
              />
            </BlobMask>
          </div>
        </div>
      </div>

    </div>

    <!-- Bottom Row: Signature -->
    <div class="flex justify-center md:justify-start pt-12 md:pt-0">
      <p class="sobre__signature font-display italic font-regular text-[clamp(1.5rem,4vw,2.5rem)] text-bordo opacity-0">
        "Entre palavras, entre pessoas — é só entrar."
      </p>
    </div>
  </div>

  <script>
    import { animateSobre } from "@/animations/sobre";
    animateSobre();
  </script>
</section>

<style>
  .sobre__title-word {
    will-change: transform, opacity;
  }
</style>