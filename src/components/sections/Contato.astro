---
import { Image } from "astro:assets";
import texturePaper from "@/assets/textures/old-paper-vintage-texture-surface-background-recycle-pale-brown-paper-crumpled-texture.webp";
import Decorative from "@/components/ui/Decorative.astro";
import TornPaperFrame from "@/components/ui/TornPaperFrame.astro";
---

<section
  class="contato relative py-24 md:py-40 px-6 md:px-16 overflow-hidden"
  id="contato"
  style="background-color: #f0ede8;"
>
  <!-- Background Assets -->
  <div class="absolute inset-0 z-0 opacity-[0.03] pointer-events-none mix-blend-multiply">
    <Image 
      src={texturePaper} 
      alt="" 
      class="w-full h-full object-cover"
    />
  </div>

  <!-- Background Decor -->
  <div class="absolute top-[10%] left-[5%] opacity-15 z-0 pointer-events-none">
    <Decorative variant="star" color="#3D1020" size={80} />
  </div>
  <div class="absolute bottom-[10%] right-[10%] opacity-10 z-0 pointer-events-none">
    <Decorative variant="dots" color="#3D1020" size={60} />
  </div>
  <div class="absolute top-[40%] right-[5%] opacity-10 z-0 pointer-events-none hidden md:block">
    <Decorative variant="ray" color="#ec6838" size={120} />
  </div>

  <div class="max-w-[1300px] mx-auto relative z-10">
    <!-- Header -->
    <div class="contato__header mb-16 md:mb-24">
      <div class="overflow-hidden mb-6">
        <p class="contato__eyebrow font-display font-bold text-[10px] uppercase tracking-[0.4em] text-bordo/40 opacity-0">
          Conexão & Criatividade
        </p>
      </div>

      <h2 class="contato__title font-display font-black text-[clamp(2.5rem,6vw,6rem)] text-bordo leading-[0.85] uppercase opacity-0">
        Venha nos <br />
        <span class="italic text-orange">visitar</span>
      </h2>
    </div>

    <!-- Grid: Info + Map -->
    <div class="flex flex-col lg:flex-row gap-16 lg:gap-24">

      <!-- Left: Contact Info - Alinhado com estilo editorial -->
      <div class="w-full lg:w-[45%]">
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-x-12 gap-y-16">
          <!-- Address -->
          <div class="contato__info opacity-0">
            <p class="font-display font-bold text-[10px] uppercase tracking-[0.3em] text-bordo/40 mb-5 border-b border-bordo/10 pb-2">
              Endereço
            </p>
            <address class="not-italic text-lg font-display text-bordo leading-snug">
              Rua Maria Calmon, 100<br />
              Méier, Rio de Janeiro<br />
              CEP 20710-030
            </address>
          </div>

          <!-- Hours -->
          <div class="contato__info opacity-0">
            <p class="font-display font-bold text-[10px] uppercase tracking-[0.3em] text-bordo/40 mb-5 border-b border-bordo/10 pb-2">
              Horário
            </p>
            <p class="text-lg font-display text-bordo leading-relaxed">
              Quarta a Sexta: 10h às 18h<br />
              Sábado: 10h às 15h
            </p>
          </div>

          <!-- Contact -->
          <div class="contato__info opacity-0">
            <p class="font-display font-bold text-[10px] uppercase tracking-[0.3em] text-bordo/40 mb-5 border-b border-bordo/10 pb-2">
              Contato
            </p>
            <div class="space-y-2">
              <a href="mailto:contato@estudioentre.com.br" class="block text-lg font-display text-bordo hover:text-orange transition-colors duration-300">
                contato@estudioentre.com.br
              </a>
              <a href="https://wa.me/5521973101451" class="block text-lg font-display text-bordo hover:text-orange transition-colors duration-300">
                (21) 97310-1451
              </a>
            </div>
          </div>

          <!-- Social -->
          <div class="contato__info opacity-0">
            <p class="font-display font-bold text-[10px] uppercase tracking-[0.3em] text-bordo/40 mb-5 border-b border-bordo/10 pb-2">
              Redes
            </p>
            <div class="flex gap-4">
              <a href="https://instagram.com/entrenoestudio" target="_blank" rel="noopener noreferrer" class="group w-12 h-12 rounded-full border border-bordo/10 flex items-center justify-center hover:border-orange transition-all duration-500" aria-label="Instagram">
                <img src="/icons/instagram.svg" class="w-5 h-5 opacity-40 group-hover:opacity-100 transition-all duration-500" alt="" />
              </a>
              <a href="https://tiktok.com/@entrenoestudio" target="_blank" rel="noopener noreferrer" class="group w-12 h-12 rounded-full border border-bordo/10 flex items-center justify-center hover:border-orange transition-all duration-500" aria-label="TikTok">
                <img src="/icons/tiktok.svg" class="w-5 h-5 opacity-40 group-hover:opacity-100 transition-all duration-500" alt="" />
              </a>
              <a href="https://wa.me/5521973101451" target="_blank" rel="noopener noreferrer" class="group w-12 h-12 rounded-full border border-bordo/10 flex items-center justify-center hover:border-orange transition-all duration-500" aria-label="WhatsApp">
                <img src="/icons/whatsapp.svg" class="w-5 h-5 opacity-40 group-hover:opacity-100 transition-all duration-500" alt="" />
              </a>
            </div>
          </div>
        </div>
      </div>

      <!-- Right: Google Maps with Torn Paper Effect -->
      <div class="w-full lg:w-[55%]">
        <div class="contato__map opacity-0 relative">
          <TornPaperFrame variant={1} rotation="-0.5deg" class="w-full h-[400px] md:h-[550px] shadow-2xl">
            <iframe
              src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3675.5!2d-43.2768551!3d-22.9043232!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x997dfb60237e13%3A0x62d186bbbf12a3b1!2sEst%C3%BAdio%20Entre%20-%20Centro%20Cultural%20M%C3%A9ier!5e0!3m2!1spt-BR!2sbr!4v1"
              width="100%"
              height="100%"
              style="border:0;"
              allowfullscreen=""
              loading="lazy"
              referrerpolicy="no-referrer-when-downgrade"
              title="Estúdio Entre — Google Maps"
            ></iframe>
          </TornPaperFrame>
        </div>
      </div>

    </div>
  </div>

  <script>
    import { animateContato } from "@/animations/contato";
    animateContato();
  </script>

</section>

<style>
  .contato__info {
    will-change: transform, opacity;
  }
</style>