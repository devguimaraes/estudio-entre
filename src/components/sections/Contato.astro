---
import Decorative from "@/components/ui/Decorative.astro";
---

<section
  class="contato relative py-24 md:py-40 px-6 md:px-16 overflow-hidden"
  id="contato"
  style="background-color: #777BDE;"
>
  <!-- Background Decor -->
  <div class="absolute top-[10%] left-[5%] opacity-10 z-0 pointer-events-none">
    <Decorative type="star" color="#3D1020" size={60} />
  </div>
  <div class="absolute bottom-[10%] right-[10%] opacity-10 z-0 pointer-events-none">
    <Decorative type="dots" color="#3D1020" size={50} />
  </div>

  <div class="max-w-[1300px] mx-auto relative z-10">
    <!-- Header -->
    <div class="contato__header mb-12 md:mb-20">
      <div class="overflow-hidden mb-6">
        <p class="contato__eyebrow font-display font-bold text-[10px] uppercase tracking-[0.4em] text-bordo/40 opacity-0">
          Conexão & Criatividade
        </p>
      </div>
      
      <h2 class="contato__title font-display font-black text-[clamp(2rem,5.5vw,5rem)] text-bordo leading-[0.9] uppercase opacity-0">
        Venha nos <br />
        <span class="italic text-cream">visitar</span>
      </h2>
    </div>

    <!-- Grid: Info + Map -->
    <div class="flex flex-col lg:flex-row gap-12 lg:gap-16">
      
      <!-- Left: Contact Info -->
      <div class="w-full lg:w-2/5 space-y-10">
        <!-- Address -->
        <div class="contato__info opacity-0">
          <p class="font-display font-bold text-[10px] uppercase tracking-widest text-bordo/50 mb-3">
            Endereço
          </p>
          <p class="text-lg font-display text-bordo leading-relaxed">
            Rua Dias da Cruz, 630 — Sala 301<br />
            Méier, Rio de Janeiro — RJ<br />
            CEP 20720-011
          </p>
        </div>

        <!-- Hours -->
        <div class="contato__info opacity-0">
          <p class="font-display font-bold text-[10px] uppercase tracking-widest text-bordo/50 mb-3">
            Horário
          </p>
          <p class="text-lg font-display text-bordo leading-relaxed">
            Seg a Sex: 9h às 20h<br />
            Sáb: 10h às 16h
          </p>
        </div>

        <!-- Contact -->
        <div class="contato__info opacity-0">
          <p class="font-display font-bold text-[10px] uppercase tracking-widest text-bordo/50 mb-3">
            Contato
          </p>
          <p class="text-lg font-display text-bordo leading-relaxed">
            <a href="mailto:contato@estudioentre.com.br" class="hover:text-orange transition-colors">
              contato@estudioentre.com.br
            </a><br />
            <a href="https://wa.me/5521988001234" class="hover:text-orange transition-colors">
              (21) 98800-1234
            </a>
          </p>
        </div>

        <!-- Social -->
        <div class="contato__info opacity-0">
          <p class="font-display font-bold text-[10px] uppercase tracking-widest text-bordo/50 mb-3">
            Redes
          </p>
          <div class="flex gap-4">
            <a href="#" class="w-10 h-10 rounded-full border border-bordo/20 flex items-center justify-center hover:bg-bordo hover:text-cream transition-all duration-500 text-bordo">
              <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/></svg>
            </a>
            <a href="#" class="w-10 h-10 rounded-full border border-bordo/20 flex items-center justify-center hover:bg-bordo hover:text-cream transition-all duration-500 text-bordo">
              <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M24 4.557c-.883.392-1.832.656-2.828.775 1.017-.609 1.798-1.574 2.165-2.724-.951.564-2.005.974-3.127 1.195-.897-.957-2.178-1.555-3.594-1.555-3.179 0-5.515 2.966-4.797 6.045-4.091-.205-7.719-2.165-10.148-5.144-1.29 2.213-.669 5.108 1.523 6.574-.806-.026-1.566-.247-2.229-.616-.054 2.281 1.581 4.415 3.949 4.89-.693.188-1.452.232-2.224.084.626 1.956 2.444 3.379 4.6 3.419-2.07 1.623-4.678 2.348-7.29 2.04 2.179 1.397 4.768 2.212 7.548 2.212 9.142 0 14.307-7.721 13.995-14.646.962-.695 1.797-1.562 2.457-2.549z"/></svg>
            </a>
          </div>
        </div>
      </div>

      <!-- Right: Interactive Map -->
      <div class="w-full lg:w-3/5 opacity-0">
        <div id="mapa-contato" class="contato__map relative w-full h-[400px] md:h-[500px] overflow-hidden rounded-2xl z-[1]"></div>
      </div>

    </div>
  </div>

  <script is:inline>
    if (window.__contatoMapInitialized) return;
    window.__contatoMapInitialized = true;

    const link = document.createElement('link');
    link.rel = 'stylesheet';
    link.href = 'https://unpkg.com/leaflet@1.9.4/dist/leaflet.css';
    document.head.appendChild(link);

    const script = document.createElement('script');
    script.src = 'https://unpkg.com/leaflet@1.9.4/dist/leaflet.js';
    script.onload = () => {
      const map = L.map('mapa-contato', {
        scrollWheelZoom: false,
        zoomControl: false,
      }).setView([-22.9043232, -43.2768551], 15);

      L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
        attribution: '© OpenStreetMap',
      }).addTo(map);

      L.marker([-22.9043232, -43.2768551]).addTo(map)
        .bindPopup('<strong>Estúdio Entre</strong><br>Centro Cultural')
        .openPopup();

      L.control.zoom({ position: 'topright' }).addTo(map);

      // Fix map size after GSAP animation completes
      const observer = new MutationObserver(() => {
        const section = document.querySelector('.contato');
        if (section && section.classList.contains('is-ready')) {
          map.invalidateSize();
          observer.disconnect();
        }
      });
      observer.observe(document.querySelector('.contato') || document.body, {
        attributes: true,
        attributeFilter: ['class'],
      });

      // Fallback
      setTimeout(() => map.invalidateSize(), 2000);
    };
    document.head.appendChild(script);
  </script>
</section>

<style>
  .contato__info {
    will-change: transform, opacity;
  }
</style>