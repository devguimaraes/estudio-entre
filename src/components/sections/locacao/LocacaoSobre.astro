---
import HalftoneTexture from "@/components/ui/HalftoneTexture.astro";
import { locacaoSobre, locacaoStats } from "@/content/locacao";
---

<section
  class="locacao-sobre relative overflow-hidden px-4 py-20 md:px-16 md:py-32"
  style="background-color: #3d1020;"
  data-bg-color="#3D1020"
  data-nav-theme="light"
>
  <HalftoneTexture density={16} dotSize={1.2} color="240,237,232" opacity={0.08} class="z-0" />

  <div class="relative z-10 mx-auto max-w-[1200px]">
    <p class="locacao-sobre__eyebrow font-display text-[10px] font-bold uppercase tracking-[0.45em] text-orange opacity-0">
      {locacaoSobre.eyebrow}
    </p>

    <h2
      class="locacao-sobre__title mt-6 max-w-3xl font-display text-[clamp(2rem,6vw,4rem)] font-black uppercase leading-[0.9] text-cream opacity-0"
    >
      {locacaoSobre.titulo}
    </h2>

    <p class="locacao-sobre__text mt-8 max-w-2xl text-base leading-relaxed text-cream/85 opacity-0 md:text-lg">
      {locacaoSobre.texto}
    </p>

    <dl class="locacao-sobre__stats mt-12 grid grid-cols-2 gap-6 md:mt-16 md:grid-cols-4 md:gap-8">
      {
        locacaoStats.map((stat) => (
          <div class="locacao-sobre__stat rounded-2xl border border-cream/10 bg-cream/5 px-5 py-6 opacity-0 md:px-6 md:py-8">
            <dt class="font-display text-[clamp(2rem,5vw,3rem)] font-black leading-none text-orange">
              {stat.valor}
            </dt>
            <dd class="mt-3 font-display text-sm leading-snug text-cream/80 md:text-base">{stat.label}</dd>
          </div>
        ))
      }
    </dl>
  </div>

  <script>
    import { animateLocacaoSobre } from "@/animations/locacao";
    animateLocacaoSobre();
  </script>
</section>

<style>
  .locacao-sobre__eyebrow,
  .locacao-sobre__title,
  .locacao-sobre__text,
  .locacao-sobre__stat {
    will-change: transform, opacity;
  }
</style>
