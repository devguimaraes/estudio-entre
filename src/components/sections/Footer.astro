---
import { Image } from "astro:assets";
import logoClaro from "@/assets/logos/Logo_Estudio Entre - Claro 1.png";
---

<footer class="footer relative py-24 md:py-40 px-6 md:px-16 overflow-hidden" style="background-color: #1A1612;">

  <!-- Watermark "eNTRE" gigante -->
  <div
    class="footer__watermark absolute bottom-[-5%] left-1/2 -translate-x-1/2 font-display font-black italic uppercase text-[22vw] opacity-[0.04] pointer-events-none select-none whitespace-nowrap z-0"
    style="color: #F0EDE8;"
  >
    eNTRE
  </div>

  <div class="max-w-[1300px] mx-auto relative z-10">
    <!-- 3 Columns Editorial Layout -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-16 md:gap-12 mb-24 md:mb-32">

      <!-- Col 1: Logo & Tagline -->
      <div class="footer__col opacity-0 flex flex-col items-start">
        <Image
          src={logoClaro}
          alt="Estúdio Entre"
          class="w-48 md:w-56 h-auto mb-10"
          loading="lazy"
        />
        <p class="font-display italic text-lg text-cream/60 max-w-[280px]">
          "Entre palavras, entre pessoas — é só entrar."
        </p>
      </div>

      <!-- Col 2: Services & Mission -->
      <div class="footer__col opacity-0">
        <p class="font-display font-bold text-[10px] uppercase tracking-[0.4em] text-cream/40 mb-10">
          O que somos
        </p>
        <p class="text-base md:text-lg leading-relaxed text-cream/70 mb-8 max-w-[320px]">
          Hub cultural independente no Méier, Rio de Janeiro. Um espaço para o encontro entre arte, cuidado e comunidade.
        </p>
        <ul class="space-y-3 text-sm text-cream/50 font-display italic">
          <li>Biblioterapia</li>
          <li>Oficinas Criativas</li>
          <li>Palestras & Diálogos</li>
          <li>Saraus & Encontros</li>
          <li>Estúdio de Áudio</li>
        </ul>
      </div>

      <!-- Col 3: Practical Info & Social -->
      <div class="footer__col opacity-0 flex flex-col gap-12">
        <div>
          <p class="font-display font-bold text-[10px] uppercase tracking-[0.4em] text-cream/40 mb-6">Localização</p>
          <address class="not-italic text-base text-cream/70 leading-relaxed">
            Rua Maria Calmon, 100 — Méier<br />
            Rio de Janeiro, RJ<br />
            20710-030
          </address>
        </div>

        <div>
          <p class="font-display font-bold text-[10px] uppercase tracking-[0.4em] text-cream/40 mb-6">Conecte-se</p>
          <div class="flex items-center gap-6">
            <a href="https://instagram.com/entrenoestudio" target="_blank" class="group flex items-center justify-center w-12 h-12 rounded-full border border-cream/20 hover:border-orange transition-all duration-500" aria-label="Instagram">
              <img src="/icons/instagram.svg" class="w-5 h-5 invert opacity-60 group-hover:opacity-100 transition-all duration-500" alt="" />
            </a>
            <a href="https://tiktok.com/@entrenoestudio" target="_blank" class="group flex items-center justify-center w-12 h-12 rounded-full border border-cream/20 hover:border-orange transition-all duration-500" aria-label="TikTok">
              <img src="/icons/tiktok.svg" class="w-5 h-5 invert opacity-60 group-hover:opacity-100 transition-all duration-500" alt="" />
            </a>
            <a href="https://wa.me/5521973101451" class="group flex items-center justify-center w-12 h-12 rounded-full border border-cream/20 hover:border-orange transition-all duration-500" aria-label="WhatsApp">
              <img src="/icons/whatsapp.svg" class="w-5 h-5 invert opacity-60 group-hover:opacity-100 transition-all duration-500" alt="" />
            </a>
            <a
              href="https://www.google.com/search?q=Est%C3%BAdio+Entre"
              target="_blank"
              class="group flex items-center justify-center w-12 h-12 rounded-full border border-cream/20 hover:border-orange transition-all duration-500"
              aria-label="Google Meu Negócio"
            >
              <img src="/icons/gmb.svg" class="w-5 h-5 invert opacity-60 group-hover:opacity-100 transition-all duration-500" alt="" />
            </a>
          </div>
        </div>
      </div>
    </div>

    <!-- Bottom Bar -->
    <div class="border-t border-cream/10 pt-10">
      <div class="flex flex-col md:flex-row items-center justify-between gap-6">
        <p class="text-[9px] uppercase tracking-[0.4em] text-cream/30">
          © 2026 Estúdio Entre · Rio de Janeiro · Brasil
        </p>
        <div class="flex items-center gap-8">
           <a href="#" class="text-[9px] uppercase tracking-[0.3em] text-cream/20 hover:text-cream transition-colors">Privacidade</a>
           <a href="#" class="text-[9px] uppercase tracking-[0.3em] text-cream/20 hover:text-cream transition-colors">Termos</a>
           <span class="text-[9px] uppercase tracking-[0.3em] text-cream/10">Desenvolvido com 🗝️</span>
        </div>
      </div>
    </div>
  </div>

  <script>
    import { animateFooter } from "@/animations/footer";
    animateFooter();
  </script>
</footer>
