---
import { Image } from "astro:assets";
import logoClaro from "@/assets/logos/Logo_Estudio Entre - Claro 1.png";
---

<footer class="footer relative py-20 md:py-28 px-6 md:px-16 overflow-hidden" style="background-color: #1a1612;">
  <!-- Watermark -->
  <div
    class="absolute bottom-0 left-1/2 -translate-x-1/2 translate-y-1/4 font-display font-black italic uppercase text-[15vw] opacity-[0.04] pointer-events-none select-none whitespace-nowrap"
    style="color: #f0ede8;"
  >
    eNTRE
  </div>

  <div class="max-w-6xl mx-auto relative z-10">
    <!-- 3 Columns -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-12 md:gap-8 mb-16">
      <!-- Col 1: Logo -->
      <div class="footer__col opacity-0">
        <Image
          src={logoClaro}
          alt="Estúdio Entre"
          class="w-40 md:w-48 h-auto mb-6"
          loading="lazy"
        />
      </div>

      <!-- Col 2: Description -->
      <div class="footer__col opacity-0">
        <p class="text-sm md:text-base leading-relaxed mb-4" style="color: rgba(240,237,232,0.7);">
          Hub cultural no Méier, Rio de Janeiro.
        </p>
        <p class="text-sm leading-relaxed" style="color: rgba(240,237,232,0.5);">
          Biblioterapia, oficinas, palestras, encontros e estúdio de gravação.
        </p>
      </div>

      <!-- Col 3: Address + Social -->
      <div class="footer__col opacity-0">
        <div class="mb-6">
          <p class="text-[10px] uppercase tracking-[0.3em] mb-2" style="color: rgba(240,237,232,0.4);">Endereço</p>
          <p class="text-sm" style="color: rgba(240,237,232,0.7);">
            Rua Honório, 47 — Méier<br />
            Rio de Janeiro, RJ
          </p>
        </div>

        <div class="mb-6">
          <p class="text-[10px] uppercase tracking-[0.3em] mb-2" style="color: rgba(240,237,232,0.4);">Redes</p>
          <div class="flex gap-4">
            <a href="https://instagram.com/estudioentre" target="_blank" class="opacity-50 hover:opacity-100 transition-opacity" aria-label="Instagram">
              <img src="/icons/spark.svg" class="w-5 h-5 invert" alt="" />
            </a>
            <a href="https://tiktok.com/@estudioentre" target="_blank" class="opacity-50 hover:opacity-100 transition-opacity" aria-label="TikTok">
              <img src="/icons/tiktok.svg" class="w-5 h-5 invert" alt="" />
            </a>
            <a href="#" class="opacity-50 hover:opacity-100 transition-opacity" aria-label="WhatsApp">
              <img src="/icons/whatsapp.svg" class="w-5 h-5 invert" alt="" />
            </a>
          </div>
        </div>

        <div>
          <a
            href="https://www.google.com/search?q=Est%C3%BAdio+Entre"
            target="_blank"
            class="inline-flex items-center gap-2 text-sm transition-colors hover:text-orange"
            style="color: rgba(240,237,232,0.6);"
          >
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor"><path d="M12.545 10.239v3.821h5.445c-.712 2.315-2.647 3.972-5.445 3.972a6.033 6.033 0 110-12.064c1.498 0 2.866.549 3.921 1.453l2.814-2.814A9.969 9.969 0 0012.545 2C7.021 2 2.543 6.477 2.543 12s4.478 10 10.002 10c8.396 0 10.249-7.85 9.426-11.748l-9.426-.013z"/></svg>
            Google Meu Negócio
          </a>
        </div>
      </div>
    </div>

    <!-- Divider -->
    <div class="border-t pt-8" style="border-color: rgba(240,237,232,0.1);">
      <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4">
        <p class="text-[10px] uppercase tracking-widest" style="color: rgba(240,237,232,0.3);">
          © 2026 Estúdio Entre · Rio de Janeiro
        </p>
        <p class="text-sm font-display italic" style="color: rgba(240,237,232,0.4);">
          "Entre palavras, entre pessoas — é só entrar."
        </p>
      </div>
    </div>
  </div>

  <script>
    import { animateFooter } from "@/animations/footer";
    animateFooter();
  </script>
</footer>
