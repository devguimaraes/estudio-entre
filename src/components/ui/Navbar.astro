---
import DesktopNav from "@/components/islands/DesktopNav";
import MobileNav from "@/components/islands/MobileNav";

interface Props {
  theme?: "light" | "dark";
}

const { theme = "light" } = Astro.props;
---

<nav class={`navbar navbar--${theme}`} aria-label="Menu principal">
  <div class="navbar__inner">
    <a href="/" class="navbar__logo" aria-label="Estúdio Entre — Início">
      <img src="/icons/olho.svg" alt="" width="48" height="34" aria-hidden="true" />
    </a>

    <DesktopNav client:idle />

    <MobileNav client:visible />
  </div>
</nav>

<script>
  import { initNavbar } from "@/animations/navbar";
  initNavbar();
</script>

<style>
  .navbar {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    z-index: 100;
    background: transparent;
    transition: color 0.6s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .navbar--light {
    color: var(--color-cream);
  }

  .navbar--dark {
    color: var(--color-near-black);
  }

  .navbar__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    max-width: 1400px;
    margin: 0 auto;
    padding: 1.25rem 4rem;
  }

  .navbar__logo {
    display: flex;
    align-items: center;
    text-decoration: none;
    line-height: 0;
  }

  .navbar__logo img {
    width: 48px;
    height: auto;
  }

  .navbar--light .navbar__logo img {
    filter: brightness(0) invert(1);
  }

  .navbar--dark .navbar__logo img {
    filter: none;
  }

  :global(.navbar__links) {
    display: flex;
    align-items: center;
    gap: 2rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  :global(.navbar__group) {
    position: relative;
  }

  :global(.navbar__link),
  :global(.navbar__trigger) {
    font-family: var(--font-body);
    font-weight: 700;
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    text-decoration: none;
    color: inherit;
    opacity: 0.7;
    transition: opacity 0.3s ease;
    background: none;
    border: none;
    cursor: pointer;
    padding: 0;
  }

  :global(.navbar__trigger) {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
  }

  :global(.navbar__chevron) {
    width: 0.85rem;
    height: 0.85rem;
    transition: transform 0.18s cubic-bezier(0.33, 1, 0.68, 1);
  }

  :global(.navbar__group.is-open .navbar__chevron),
  :global(.navbar__group:has(.navbar__dropdown.is-open) .navbar__chevron) {
    transform: rotate(180deg);
  }

  :global(.navbar__link:hover),
  :global(.navbar__link.is-active),
  :global(.navbar__trigger:hover),
  :global(.navbar__trigger.is-active),
  :global(.navbar__group.is-active > .navbar__trigger) {
    opacity: 1;
  }

  :global(.navbar__dropdown) {
    position: absolute;
    top: calc(100% + 0.75rem);
    left: 50%;
    min-width: 11rem;
    margin: 0;
    padding: 0.5rem 0;
    list-style: none;
    border: 1px solid transparent;
    border-radius: 0.25rem;
    transform: translateX(-50%) translateY(0.35rem);
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition:
      opacity 0.12s cubic-bezier(0.33, 1, 0.68, 1),
      transform 0.12s cubic-bezier(0.33, 1, 0.68, 1),
      visibility 0.12s,
      background-color 0.6s cubic-bezier(0.4, 0, 0.2, 1),
      border-color 0.6s cubic-bezier(0.4, 0, 0.2, 1),
      color 0.6s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .navbar--light :global(.navbar__dropdown) {
    background: rgba(26, 22, 18, 0.96);
    border-color: rgba(240, 237, 232, 0.12);
    color: var(--color-cream);
  }

  .navbar--dark :global(.navbar__dropdown) {
    background: rgba(240, 237, 232, 0.98);
    border-color: rgba(26, 22, 18, 0.12);
    color: var(--color-near-black);
  }

  /* Ponte invisível: cobre o gap entre trigger e painel para manter hover ativo */
  :global(.navbar__dropdown::before) {
    content: "";
    position: absolute;
    top: -0.75rem;
    left: 0;
    right: 0;
    height: 0.75rem;
  }

  :global(.navbar__dropdown.is-open) {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transform: translateX(-50%) translateY(0);
    transition:
      opacity 0.18s cubic-bezier(0.33, 1, 0.68, 1),
      transform 0.18s cubic-bezier(0.33, 1, 0.68, 1),
      visibility 0.18s,
      background-color 0.6s cubic-bezier(0.4, 0, 0.2, 1),
      border-color 0.6s cubic-bezier(0.4, 0, 0.2, 1),
      color 0.6s cubic-bezier(0.4, 0, 0.2, 1);
  }

  :global(.navbar__dropdown-link) {
    display: block;
    padding: 0.65rem 1rem;
    white-space: nowrap;
    color: inherit;
    opacity: 0.75;
  }

  .navbar--light :global(.navbar__dropdown-link:hover),
  .navbar--light :global(.navbar__dropdown-link.is-active) {
    opacity: 1;
    background: rgba(240, 237, 232, 0.06);
  }

  .navbar--dark :global(.navbar__dropdown-link:hover),
  .navbar--dark :global(.navbar__dropdown-link.is-active) {
    opacity: 1;
    background: rgba(26, 22, 18, 0.06);
  }

  :global(.navbar__link:focus-visible),
  :global(.navbar__trigger:focus-visible) {
    outline: 2px solid currentColor;
    outline-offset: 3px;
    opacity: 1;
  }

  @media (max-width: 768px) {
    :global(.navbar__links) {
      display: none;
    }

    .navbar__inner {
      padding: 1rem 1.5rem;
    }

    .navbar__logo img {
      width: 40px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .navbar,
    :global(.navbar__link),
    :global(.navbar__trigger),
    :global(.navbar__dropdown),
    :global(.navbar__chevron) {
      transition: none;
    }
  }
</style>
