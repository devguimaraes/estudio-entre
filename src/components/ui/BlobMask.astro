---
interface Props {
  variant?: 1 | 2 | 3 | 4;
  class?: string;
}

const { variant = 1, class: className = "" } = Astro.props;

// Clip-paths orgânicos e irregulares
const clips = {
  1: "ellipse(45% 48% at 50% 50%)",
  2: "polygon(20% 0%, 80% 5%, 100% 40%, 95% 80%, 60% 100%, 10% 90%, 0% 50%)",
  3: "polygon(15% 10%, 60% 0%, 90% 20%, 100% 60%, 85% 95%, 40% 100%, 5% 80%, 0% 40%)",
  4: "polygon(25% 5%, 70% 0%, 95% 30%, 90% 75%, 60% 100%, 15% 90%, 0% 55%, 10% 20%)",
  5: "polygon(2% 5%, 98% 0%, 100% 30%, 95% 95%, 5% 100%, 0% 70%)", // Borda irregular 1
  6: "polygon(5% 0%, 95% 5%, 100% 80%, 90% 100%, 10% 95%, 0% 20%)", // Borda irregular 2
  7: "polygon(0% 10%, 90% 0%, 100% 20%, 98% 90%, 5% 100%, 2% 40%)", // Borda irregular 3
};
---

<div class={`relative overflow-hidden ${className}`} style={`clip-path: ${clips[variant]};`}>
  <slot />
</div>
