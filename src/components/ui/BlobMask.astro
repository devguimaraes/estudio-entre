---
interface Props {
  variant?: 1 | 2 | 3 | 4;
  class?: string;
}

const { variant = 1, class: className = "" } = Astro.props;

const clipId = `blob-mask-${variant}-${Math.random().toString(36).slice(2, 8)}`;
---

<div class={`relative ${className}`}>
  <svg width="0" height="0" class="absolute">
    <defs>
      <clipPath id={clipId} clipPathUnits="objectBoundingBox">
        {variant === 1 && (
          <path d="M0.5,0 C0.85,0 1,0.15 1,0.5 C1,0.85 0.85,1 0.5,1 C0.15,1 0,0.85 0,0.5 C0,0.15 0.15,0 0.5,0 Z"/>
        )}
        {variant === 2 && (
          <path d="M0.3,0 C0.6,0 0.9,0.1 1,0.4 C1.1,0.7 0.9,1 0.6,1 C0.3,1 0,0.9 0,0.6 C0,0.3 0.1,0 0.3,0 Z"/>
        )}
        {variant === 3 && (
          <path d="M0.5,0 C0.75,0 0.95,0.15 1,0.4 C1.05,0.65 0.85,0.9 0.6,0.95 C0.35,1 0.1,0.85 0.05,0.6 C0,0.35 0.15,0.1 0.4,0.05 C0.45,0.02 0.48,0 0.5,0 Z"/>
        )}
        {variant === 4 && (
          <path d="M0.2,0.1 C0.4,0 0.7,0.05 0.9,0.2 C1,0.35 0.95,0.65 0.8,0.8 C0.6,0.95 0.3,1 0.15,0.85 C0,0.7 0.05,0.4 0.1,0.25 C0.12,0.18 0.16,0.13 0.2,0.1 Z"/>
        )}
      </clipPath>
    </defs>
  </svg>
  <div style={`clip-path: url(#${clipId});`}>
    <slot />
  </div>
</div>
